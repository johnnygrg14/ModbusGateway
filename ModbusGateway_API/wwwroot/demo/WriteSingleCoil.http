# For more info on HTTP files go to https://aka.ms/vs/httpfile

@baseUrl = http://localhost:5254

### Delete all connections
DELETE {{baseUrl}}/connections

### Create an RTU connection
# @name createConnection
POST {{baseUrl}}/connections
Content-Type: application/json

{
    "protocol": 0,
    "comPort": "COM1",
    "baudRate": 9600
}

### Send a valid request
PUT {{baseUrl}}/connections/{{createConnection.response.body.$.connectionId}}/devices/1/coils/single?address=0
Content-Type: application/json
{
  "value": true
}

### Send an invalid request
PUT {{baseUrl}}/connections/{{createConnection.response.body.$.connectionId}}/devices/1/coils/single?address=-1
Content-Type: application/json
{
  "value": true
}